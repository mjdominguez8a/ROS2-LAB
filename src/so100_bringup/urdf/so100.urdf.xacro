<?xml version="1.0"?>
<!--
  SO-100 robot description used by the course.
  Reuses the vendored so_arm100_description macro and adds:
    * tcp_link: the "tool centre point" between the gripper fingertips
    * a ros2_control block whose hardware is selected by `backend`
      (mock | gazebo | real) and whose servo calibration comes from a YAML file.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="so100">
  <xacro:arg name="backend" default="mock" />
  <xacro:arg name="usb_port" default="/dev/so100" />
  <xacro:arg name="calibration_file" default="$(find so100_bringup)/config/robots/default.yaml" />
  <xacro:arg name="controllers_file" default="$(find so100_bringup)/config/controllers.yaml" />
  <xacro:arg name="z" default="0.0" />

  <xacro:include filename="$(find so_arm100_description)/urdf/so_arm100_macro.xacro" />
  <xacro:include filename="$(find so100_bringup)/urdf/so100.ros2_control.xacro" />

  <link name="world" />
  <xacro:so_arm100 prefix="" z="$(arg z)" />

  <!-- Tool centre point: between the open fingertips, 4 mm clear of the fixed finger for a 2.5 cm object (gripper_link frame). -->
  <link name="tcp_link" />
  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="tcp_link" />
    <origin xyz="-0.0085 -0.0980 0.0" rpy="0 0 0" />
  </joint>

  <!-- Finger pads: the upstream gripper/jaw links have no collision geometry, so
       nothing could be grasped in Gazebo. These boxes approximate the fingertips
       (measured from Fixed_Jaw.stl / Moving_Jaw.stl). -->
  <link name="fixed_finger_pad">
    <collision>
      <origin xyz="0.012 -0.088 0" rpy="0 0 0" />
      <geometry><box size="0.008 0.036 0.012" /></geometry>
    </collision>
  </link>
  <joint name="fixed_finger_pad_joint" type="fixed">
    <parent link="gripper_link" />
    <child link="fixed_finger_pad" />
  </joint>
  <link name="moving_finger_pad">
    <collision>
      <origin xyz="-0.0082 -0.066 0" rpy="0 0 0" />
      <geometry><box size="0.008 0.032 0.012" /></geometry>
    </collision>
  </link>
  <joint name="moving_finger_pad_joint" type="fixed">
    <parent link="jaw_link" />
    <child link="moving_finger_pad" />
  </joint>
  <gazebo reference="gripper_link"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>
  <gazebo reference="jaw_link"><mu1>2.0</mu1><mu2>2.0</mu2></gazebo>

  <xacro:so100_ros2_control
    backend="$(arg backend)"
    usb_port="$(arg usb_port)"
    calibration_file="$(arg calibration_file)"
  />

  <xacro:if value="${'$(arg backend)' == 'gazebo'}">
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg controllers_file)</parameters>
      </plugin>
    </gazebo>
  </xacro:if>
</robot>
